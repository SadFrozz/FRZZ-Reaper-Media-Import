{
  "version": 5,
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "FRZZ_ENABLE_LOGGING": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos-x86_64",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-macos-x86_64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "FRZZ_ENABLE_LOGGING": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos-arm64",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "FRZZ_ENABLE_LOGGING": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos-universal",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-macos-universal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "FRZZ_ENABLE_LOGGING": "ON",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "vs2022-x64", "configuration": "Release"},
    {"name": "debug", "configurePreset": "vs2022-x64", "configuration": "Debug"},
    {"name": "mac-x86-release", "configurePreset": "macos-x86_64"},
    {"name": "mac-arm-release", "configurePreset": "macos-arm64"},
    {"name": "mac-universal-release", "configurePreset": "macos-universal"}
  ],
  "testPresets": [
    {"name": "release", "configurePreset": "vs2022-x64", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "debug", "configurePreset": "vs2022-x64", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "mac-x86-release", "configurePreset": "macos-x86_64", "output": {"outputOnFailure": true}},
    {"name": "mac-universal-release", "configurePreset": "macos-universal", "output": {"outputOnFailure": true}}
  ]
}
